{
  "name": "finger-training",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "postbuild": "node scripts/generate-asset-manifest.js && node scripts/generate-service-worker.js && node scripts/verify-service-worker.js",
    "verify:offline": "node scripts/verify-service-worker.js",
    "replay": "node --no-warnings scripts/replay.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "jest",
    "evaluate:mixed": "node --no-warnings scripts/evaluate-mixed-load.mjs",
    "evaluate:forward": "node --no-warnings scripts/evaluate-forward.mjs",
    "evaluate:history": "node --no-warnings scripts/evaluate-history.mjs",
    "evaluate:trends": "node --no-warnings scripts/evaluate-trends.mjs",
    "evaluate:adaptive": "node --no-warnings scripts/evaluate-adaptive.mjs",
    "evaluate:windows": "node --no-warnings scripts/evaluate-windows.mjs",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "vite": "8.3.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "babel-jest": "30.5.2",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "whatwg-fetch": "3.6.20"
  },
  "engines": {
    "node": ">=22.19.0 <23"
  }
}
